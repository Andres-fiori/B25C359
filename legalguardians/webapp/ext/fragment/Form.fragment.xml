<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="Dialog"
        title="{i18n>titleAppointment}"
    >
        <content>
            <form:SimpleForm id="form">
                <form:content>
                    <Label
                        id="lDoctor"
                        text="Therapist"
                        required="true"
                    />
                    <ComboBox
                        id="cbDoctor"
                        items="{/TherapistsSet}"
                        selectedKey="{form>/doctor}"
                    >
                        <items>
                            <core:Item
                                key="{ID}"
                                text="{fullName}"
                            />
                        </items>
                    </ComboBox>

                    <Label
                        id="lTypeAppointment"
                        text="{i18n>typeAppointment}"
                        required="true"
                    />
                    <ComboBox
                        id="cbTypeAppointment"
                        items="{/VH_TypesAppointments}"
                        selectedKey="{form>/typeAppointment}"
                    >
                        <items>
                            <core:Item
                                key="{ID}"
                                text="{type}"
                            />
                        </items>
                    </ComboBox>

                    <Label
                        id="lTitle"
                        text="{i18n>title}"
                        required="true"
                    />
                    <Input
                        id="ipTitle"
                        value="{form>/title}"
                    />

                    <Label
                        id="lDescription"
                        text="{i18n>description}"
                    />
                    <TextArea
                        id="txaDescription"
                        value="{form>/description}"
                    />

                    <Label
                        id="lBeginDate"
                        text="{i18n>beginDate}"
                        required="true"
                    />
                    <DatePicker
                        id="dpBeginDate"
                        value="{form>/beginDate}"
                        valueFormat="yyyy-MM-dd"
                    />

                    <Label
                        id="lBlock"
                        text="{i18n>block}"
                        required="true"
                    />
                    <ComboBox
                        id="cbBlock"
                        items="{/VH_Blocks}"
                        selectedKey="{form>/block}"
                        showSecondaryValues="true"
                    >
                        <items>
                            <core:ListItem
                                key="{ID}"
                                text="{block}"
                                additionalText="{timeText}"
                            />
                        </items>
                    </ComboBox>
                </form:content>
            </form:SimpleForm>
        </content>

        <beginButton>
            <Button
                id="Save"
                text="{i18n>save}"
                tooltip="{i18n>save}"
                type="Emphasized"
                press="onSavePress"
                width="4rem"
            />
        </beginButton>

        <endButton>
            <Button
                id="Cancel"
                text="{i18n>cancel}"
                tooltip="{i18n>cancel}"
                press="onClosePress"
                width="4rem"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>